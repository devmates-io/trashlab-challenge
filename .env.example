# Bill Pay MVP — example environment file.
# Copy to `.env` (never commit the real one) and adjust as needed.
# Every variable documented in §6.1.5 of the spec.

# Postgres connection string used by the api container. Hostname "db" matches
# the docker-compose service name.
DATABASE_URL=postgresql://postgres:postgres@db:5432/billpay

# Ports exposed on the host. Override to work around conflicts (O-R1).
API_PORT=4000
WEB_PORT=3000

# Uploads directory inside the api container (backed by the `uploads` volume).
UPLOAD_DIR=/app/uploads

# Base URL the web app uses to call the api from the user's browser.
VITE_API_URL=http://localhost:4000

# Gate for auto-seeding. When true AND the DB has zero users, the api
# container seeds on startup. Set false to suppress seed entirely.
SEED_ON_EMPTY=true

# Anthropic API key for LLM-powered invoice OCR (§6.10.1). Optional — when
# unset, POST /bills/extract returns a deterministic stub so the demo runs
# zero-config. Set to a real key to exercise the full extraction flow.
# ANTHROPIC_API_KEY=sk-ant-...
# Model used for the extraction call. Defaults to claude-sonnet-4 when unset.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
